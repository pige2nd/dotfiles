#!/usr/bin/env bash
set -u

file=${1:-}
max_lines=${OFFICE_PREVIEW_MAX_LINES:-800}

if [[ -z "$file" || ! -f "$file" ]]; then
  echo "office-preview: file not found: $file"
  exit 1
fi

have() { command -v "$1" >/dev/null 2>&1; }
limit() { sed -e 's/\r$//' | head -n "$max_lines"; }

ext=${file##*.}
ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')

preview_ooxml_docx() {
  python3 - "$file" "$max_lines" <<'PY'
import sys, zipfile, xml.etree.ElementTree as ET
path, max_lines = sys.argv[1], int(sys.argv[2])
lines = []
try:
    with zipfile.ZipFile(path) as z:
        xml = z.read('word/document.xml')
    root = ET.fromstring(xml)
    ns = {'w': 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
    for p in root.findall('.//w:p', ns):
        text = ''.join(t.text or '' for t in p.findall('.//w:t', ns)).strip()
        if text:
            lines.append(text)
            if len(lines) >= max_lines:
                break
except Exception as e:
    print(f'office-preview: failed to parse docx XML: {e}')
    sys.exit(1)
print('\n'.join(lines))
PY
}

preview_xlsx() {
  python3 - "$file" "$max_lines" <<'PY'
import sys, zipfile, re, xml.etree.ElementTree as ET
path, max_lines = sys.argv[1], int(sys.argv[2])
ns = {
    'main': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main',
    'r': 'http://schemas.openxmlformats.org/officeDocument/2006/relationships',
    'rel': 'http://schemas.openxmlformats.org/package/2006/relationships',
}

def cell_text(cell, shared):
    t = cell.attrib.get('t')
    if t == 'inlineStr':
        return ''.join(x.text or '' for x in cell.findall('.//main:t', ns))
    v = cell.find('main:v', ns)
    if v is None or v.text is None:
        return ''
    if t == 's':
        try: return shared[int(v.text)]
        except Exception: return v.text
    return v.text

def col_index(ref):
    m = re.match(r'([A-Z]+)', ref or '')
    if not m: return 0
    n = 0
    for ch in m.group(1):
        n = n * 26 + ord(ch) - 64
    return n - 1

try:
    with zipfile.ZipFile(path) as z:
        shared = []
        if 'xl/sharedStrings.xml' in z.namelist():
            root = ET.fromstring(z.read('xl/sharedStrings.xml'))
            for si in root.findall('main:si', ns):
                shared.append(''.join(t.text or '' for t in si.findall('.//main:t', ns)))

        sheet_names = {}
        rel_targets = {}
        if 'xl/workbook.xml' in z.namelist() and 'xl/_rels/workbook.xml.rels' in z.namelist():
            wb = ET.fromstring(z.read('xl/workbook.xml'))
            rels = ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
            for rel in rels:
                rid = rel.attrib.get('Id')
                target = rel.attrib.get('Target', '')
                if rid and target:
                    rel_targets[rid] = 'xl/' + target.lstrip('/')
            for sheet in wb.findall('.//main:sheet', ns):
                rid = sheet.attrib.get('{%s}id' % ns['r'])
                name = sheet.attrib.get('name')
                if rid in rel_targets and name:
                    sheet_names[rel_targets[rid]] = name

        sheets = sorted(n for n in z.namelist() if n.startswith('xl/worksheets/sheet') and n.endswith('.xml'))
        out_lines = 0
        for sheet_path in sheets:
            if out_lines >= max_lines: break
            name = sheet_names.get(sheet_path, sheet_path.rsplit('/', 1)[-1])
            print(f'# Sheet: {name}')
            out_lines += 1
            root = ET.fromstring(z.read(sheet_path))
            for row in root.findall('.//main:row', ns):
                values, last = [], -1
                for c in row.findall('main:c', ns):
                    idx = col_index(c.attrib.get('r', ''))
                    while last + 1 < idx:
                        values.append('')
                        last += 1
                    values.append(cell_text(c, shared))
                    last = idx
                while values and values[-1] == '':
                    values.pop()
                if values:
                    print('\t'.join(values))
                    out_lines += 1
                    if out_lines >= max_lines: break
            print()
            out_lines += 1
except Exception as e:
    print(f'office-preview: failed to parse xlsx: {e}')
    sys.exit(1)
PY
}

preview_pptx() {
  python3 - "$file" "$max_lines" <<'PY'
import sys, zipfile, re, xml.etree.ElementTree as ET
path, max_lines = sys.argv[1], int(sys.argv[2])
ns = {'a': 'http://schemas.openxmlformats.org/drawingml/2006/main'}
try:
    with zipfile.ZipFile(path) as z:
        slides = sorted(
            (n for n in z.namelist() if re.match(r'ppt/slides/slide\d+\.xml$', n)),
            key=lambda s: int(re.search(r'slide(\d+)\.xml$', s).group(1))
        )
        out_lines = 0
        for idx, slide in enumerate(slides, 1):
            if out_lines >= max_lines: break
            print(f'# Slide {idx}')
            out_lines += 1
            root = ET.fromstring(z.read(slide))
            texts = [t.text or '' for t in root.findall('.//a:t', ns)]
            buf = []
            for t in texts:
                t = t.strip()
                if t:
                    buf.append(t)
            for line in buf:
                print(line)
                out_lines += 1
                if out_lines >= max_lines: break
            print()
            out_lines += 1
except Exception as e:
    print(f'office-preview: failed to parse pptx: {e}')
    sys.exit(1)
PY
}

case "$ext" in
  docx|odt)
    if have pandoc; then
      tmp_out=$(mktemp)
      if pandoc --wrap=none -t plain "$file" >"$tmp_out" 2>/dev/null && [[ -s "$tmp_out" ]]; then
        limit <"$tmp_out"
        rm -f "$tmp_out"
        exit 0
      fi
      rm -f "$tmp_out"
    fi
    [[ "$ext" == "docx" ]] && preview_ooxml_docx | limit && exit 0
    echo "office-preview: install pandoc for .$ext preview"
    ;;
  rtf|doc)
    if have textutil; then
      textutil -convert txt -stdout "$file" 2>/dev/null | limit && exit 0
    fi
    if have pandoc; then
      pandoc --wrap=none -t plain "$file" 2>/dev/null | limit && exit 0
    fi
    strings "$file" | limit
    ;;
  xlsx)
    preview_xlsx | limit
    ;;
  xls)
    if have python3; then
      echo "Legacy .xls preview is limited without LibreOffice/catdoc. Showing extracted strings."
      echo
    fi
    strings "$file" | limit
    ;;
  pptx)
    preview_pptx | limit
    ;;
  ppt)
    echo "Legacy .ppt preview is limited without LibreOffice. Showing extracted strings."
    echo
    strings "$file" | limit
    ;;
  *)
    echo "office-preview: unsupported extension: .$ext"
    exit 1
    ;;
esac
