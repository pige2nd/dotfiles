#!/usr/bin/env sh
set -eu

index="${1:-}"
case "$index" in
  ''|*[!0-9]*) exit 1 ;;
esac

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
target_session_id="$("$script_dir/session-order" target "$index")"
if [ -z "$target_session_id" ]; then
  tmux display-message "No session #$index"
  exit 0
fi
target_session="$("$script_dir/session-order" name "$target_session_id")"

current_session_id="$(tmux display-message -p '#{session_id}')"
if [ "$target_session_id" = "$current_session_id" ]; then
  tmux display-message "Already in session $target_session"
  exit 0
fi

window_id="$(tmux display-message -p '#{window_id}')"
window_name="$(tmux display-message -p '#W')"

tmux move-window -d -s "$window_id" -t "${target_session_id}:"
tmux switch-client -t "$target_session_id"
tmux refresh-client -S
tmux display-message "Moved window $window_name to session $target_session"
