#!/usr/bin/env sh
set -eu

if command -v pbcopy >/dev/null 2>&1; then
  exec pbcopy
fi

if command -v win32yank.exe >/dev/null 2>&1; then
  exec win32yank.exe -i --crlf
fi

if [ -x /mnt/c/Windows/System32/clip.exe ]; then
  exec iconv -s -f UTF-8 -t UTF-16LE | /mnt/c/Windows/System32/clip.exe
fi

if command -v clip.exe >/dev/null 2>&1; then
  exec iconv -s -f UTF-8 -t UTF-16LE | clip.exe
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
  exec wl-copy
fi

if command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard -in
fi

if command -v xsel >/dev/null 2>&1; then
  exec xsel --clipboard --input
fi

cat >/dev/null
exit 1
