#!/usr/bin/env sh
set -eu

direction="${1:?missing direction}"
pane_id="${2:?missing pane id}"

case "$direction" in
  up)    layout=even-horizontal; set -- -f -v -b ;;
  down)  layout=even-horizontal; set -- -f -v ;;
  left)  layout=even-vertical; set -- -f -h -b ;;
  right) layout=even-vertical; set -- -f -h ;;
  *) exit 1 ;;
esac

if [ "$(tmux display-message -p -t "$pane_id" '#{window_panes}')" != 2 ]; then
  tmux display-message -t "$pane_id" 'Three-pane layout needs exactly two panes'
  exit 0
fi

window_id="$(tmux display-message -p -t "$pane_id" '#{window_id}')"
pane_path="$(tmux display-message -p -t "$pane_id" '#{pane_current_path}')"

tmux select-layout -t "$window_id" "$layout" \; \
  split-window "$@" -t "$pane_id" -c "$pane_path" >/dev/null
