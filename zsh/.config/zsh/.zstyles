#!/bin/zsh
#
# .zstyles - Set zstyle settings for plugins that need them.
#

#
# Antidote
#

# zstyle ':antidote:bundle' file ${ZDOTDIR:-~}/.zplugins.txt
# zstyle ':antidote:bundle' use-friendly-names 'yes'

# fzf-tab：Tab 补全使用 fzf 选择器。
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:*' fzf-flags --height=40% --layout=reverse --border=rounded --bind=tab:accept
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath 2>/dev/null || ls -la $realpath'
