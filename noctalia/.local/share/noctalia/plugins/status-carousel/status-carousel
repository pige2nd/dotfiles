#!/bin/sh
set -eu

action=${1:-}
item=${2:-}
proc_root=${NYXNIRI_PROC_ROOT:-/proc}

read_ram() {
  value=$(
    awk '
      $1 == "MemTotal:" { total = $2; found_total = 1 }
      $1 == "MemAvailable:" { available = $2; found_available = 1 }
      END {
        if (!found_total || !found_available || total <= 0 || available < 0) exit 1
        printf "%.0f", (total - available) * 100 / total
      }
    ' "$proc_root/meminfo"
  )
  printf 'ram|%s|active\n' "$value"
}

cpu_snapshot() {
  awk '
    $1 == "cpu" && NF >= 9 {
      total = 0
      # guest and guest_nice are already included in user and nice.
      for (field = 2; field <= 9; field++) total += $field
      idle = $5 + $6
      print total, idle
      found = 1
      exit
    }
    END { if (!found) exit 1 }
  ' "$1"
}

read_cpu() {
  before_file=${NYXNIRI_CPU_STAT_BEFORE:-"$proc_root/stat"}
  after_file=${NYXNIRI_CPU_STAT_AFTER:-"$proc_root/stat"}
  if ! before_snapshot=$(cpu_snapshot "$before_file"); then
    return 1
  fi
  # The snapshot is exactly two numeric fields; word splitting is intentional.
  set -- $before_snapshot
  test "$#" -eq 2 || return 1
  total_before=$1
  idle_before=$2
  sleep "${NYXNIRI_CPU_SAMPLE_SECONDS:-0.1}"
  if ! after_snapshot=$(cpu_snapshot "$after_file"); then
    return 1
  fi
  # The snapshot is exactly two numeric fields; word splitting is intentional.
  set -- $after_snapshot
  test "$#" -eq 2 || return 1
  total_after=$1
  idle_after=$2

  if ! value=$(
    awk \
      -v total_before="$total_before" \
      -v idle_before="$idle_before" \
      -v total_after="$total_after" \
      -v idle_after="$idle_after" '
        BEGIN {
          total_delta = total_after - total_before
          idle_delta = idle_after - idle_before
          if (total_delta <= 0) exit 1
          value = (total_delta - idle_delta) * 100 / total_delta
          if (value < 0) value = 0
          if (value > 100) value = 100
          printf "%.0f", value
        }
      '
  ); then
    return 1
  fi
  printf 'cpu|%s|active\n' "$value"
}

read_volume() {
  wpctl_command=${NYXNIRI_WPCTL:-wpctl}
  output=$(LC_ALL=C "$wpctl_command" get-volume @DEFAULT_AUDIO_SINK@)
  value=$(printf '%s\n' "$output" | awk '{ printf "%.0f", $2 * 100 }')
  case "$output" in
    *'[MUTED]'*) state=muted ;;
    *) state=active ;;
  esac
  printf 'volume|%s|%s\n' "$value" "$state"
}

read_brightness() {
  brightnessctl_command=${NYXNIRI_BRIGHTNESSCTL:-brightnessctl}
  output=$(LC_ALL=C "$brightnessctl_command" -m)
  value=$(printf '%s\n' "$output" | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }')
  test -n "$value"
  printf 'brightness|%s|active\n' "$value"
}

read_battery() {
  power_supply_root=${NYXNIRI_POWER_SUPPLY_ROOT:-/sys/class/power_supply}
  for device_dir in "$power_supply_root"/*; do
    test -d "$device_dir" || continue
    test -r "$device_dir/type" || continue
    test "$(cat "$device_dir/type")" = Battery || continue
    if test -r "$device_dir/present" && test "$(cat "$device_dir/present")" != 1; then
      continue
    fi
    test -r "$device_dir/capacity" || continue
    value=$(cat "$device_dir/capacity")
    if test -r "$device_dir/status"; then
      state=$(cat "$device_dir/status")
    else
      state=Unknown
    fi
    printf 'battery|%s|%s\n' "$value" "$state"
    return 0
  done
  return 2
}

case "$action:$item" in
  read:ram) read_ram ;;
  read:cpu) read_cpu ;;
  read:volume) read_volume ;;
  read:brightness) read_brightness ;;
  read:battery) read_battery ;;
  *) printf 'usage: %s read {ram|cpu|battery|volume|brightness}\n' "$0" >&2; exit 2 ;;
esac
